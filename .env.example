# Node.js 22 or later. Copy this file to .env; keep all real keys server-side.
# Gemini is the default. Select qwen explicitly; there is no automatic fallback.
MENTOR_AI_PROVIDER=gemini
# Optional. Empty uses GEMINI_MODEL for Gemini or qwen-plus for Qwen.
MENTOR_AI_MODEL=
GEMINI_API_KEY=
# Override only with a Gemini model supporting generateContent and JSON output.
GEMINI_MODEL=gemini-3.1-flash-lite
# Qwen Model Studio key for the selected region. DASHSCOPE_API_KEY is also accepted.
# The key and MENTOR_QWEN_BASE_URL must belong to the same region.
QWEN_API_KEY=
# Optional. Empty uses the official Singapore compatibility endpoint.
# For another region, use its official /compatible-mode/v1 base URL.
MENTOR_QWEN_BASE_URL=
PORT=3000
# Optional USDA key for food discovery/import. Empty uses the limited public DEMO_KEY.
USDA_API_KEY=
# Optional private stable key (32+ random characters) for pending food approvals across restarts.
MENTOR_FOOD_SIGNING_KEY=
